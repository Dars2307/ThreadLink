# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Secrets. NEVER commit real environment files.
# Everything matching .env* is ignored; only the placeholder template is allowed.
# ---------------------------------------------------------------------------
.env*
!.env.example
# Plain-text copies of env files (e.g. .env.txt, env.txt) are also secrets.
*.env.txt
env.txt
secrets/

# vercel
.vercel

# local tooling
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
