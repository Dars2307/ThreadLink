# ThreadLink environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local or real secrets.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser: never put a secret there.

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
THREADLINK_ENV=development

# --- Clerk (identity authority) ---------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase (Postgres persistence; Supabase Auth is NOT used) -------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Server-only. Used for migrations (supabase db push). Use the Session pooler string (IPv4).
DATABASE_URL=postgresql://postgres.your-project-ref:replace_me@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- ThreadLink security -----------------------------------------------------
# REQUIRED (Phase 3). Server-only HMAC key for connection-credential hashes.
# Generate 32 random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must differ per environment and never reuse a Clerk/Supabase key.
# Rotating it invalidates every issued connection credential.
THREADLINK_CONNECTION_SECRET=replace_with_32_random_bytes_base64url
# Reserved for later phases (not read yet):
THREADLINK_APP_SECRET=
THREADLINK_TOKEN_ISSUER=
THREADLINK_ENCRYPTION_KEY=
THREADLINK_HMAC_SECRET=
THREADLINK_PAIRING_TTL_SECONDS=600
THREADLINK_REQUEST_TTL_SECONDS=300
# Must be false (or unset) in production; the app refuses to start otherwise.
THREADLINK_ALLOW_INSECURE_DEV=false

# --- MCP / Claude Code bridge (reserved for later phases) --------------------
THREADLINK_MCP_URL=http://localhost:3000/api/mcp
THREADLINK_API_URL=http://localhost:3000
THREADLINK_CONNECTION_ID=
THREADLINK_CONNECTION_TOKEN=
THREADLINK_AGENT_NAME=
THREADLINK_AGENT_TYPE=claude_code

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# Keep false: request bodies may contain user content.
THREADLINK_LOG_REQUEST_BODIES=false
