{
  "name": "threadlink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p runtime && tsc -p desktop --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:db": "supabase test db",
    "test:all": "npm run test && npm run test:db && npm run test:integration",
    "db:start": "supabase start",
    "db:reset:local": "supabase db reset --local",
    "dev:local-db": "node scripts/dev-local-supabase.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "runtime": "node runtime/src/cli.ts",
    "desktop": "npm --prefix desktop start"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "jose": "^6.2.12",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
